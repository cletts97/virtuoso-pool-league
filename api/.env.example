# Copy to api/.env for the local HTTP runner. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/postgres
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_SECRET_KEY=
APP_URL=http://127.0.0.1:5173
# '*' permits any email domain, still restricted to confirmed, invited, active accounts.
# An explicit comma-separated domain list remains supported; empty denies all access.
WORK_EMAIL_DOMAINS=*
# Both stay disabled until the operator has configured/tested and approved their use.
ALLOW_AUTH_EMAIL=false
PUBLIC_DISPLAY_ENABLED=false
# Optional PEM CA certificate for verified database TLS (literal \n accepted).
DATABASE_CA_CERT=

# Separate from Supabase Auth SMTP. Apply the result-email outbox migration first.
ALLOW_RESULT_EMAIL=false
RESEND_API_KEY=
# Plain email address from your verified Resend sending domain.
RESULT_EMAIL_FROM=
