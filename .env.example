# Default: mock, with no external services. Use api to connect to the local/hosted API.
VITE_DATA_MODE=mock
# Required only for api mode. These values are PUBLIC and embedded in the browser bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional absolute URL used by the TV's booking QR code; otherwise the current origin.
VITE_PUBLIC_APP_URL=
